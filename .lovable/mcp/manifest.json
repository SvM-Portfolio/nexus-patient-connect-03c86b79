{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "remix-of-patient-connect-hub",
      "version": "0.1.0",
      "title": "Remix of Patient Connect Hub"
    },
    "tools": [
      {
        "name": "search_patients",
        "title": "Search patients",
        "description": "Search synthetic demo patients by name, returning id, name, gender and birth date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "name": {
              "description": "Given, family or full name.",
              "type": "string",
              "maxLength": 100
            },
            "count": {
              "description": "Max results (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_patient",
        "title": "Get patient",
        "description": "Fetch the full FHIR Patient resource for a synthetic demo patient by id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9\\-.]{1,64}$",
              "description": "FHIR Patient id."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_patient_resources",
        "title": "List patient clinical records",
        "description": "List a patient's clinical records of one type (e.g. Observation, Condition, MedicationRequest).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "patientId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9\\-.]{1,64}$",
              "description": "FHIR Patient id."
            },
            "resourceType": {
              "type": "string",
              "enum": [
                "Observation",
                "Condition",
                "Encounter",
                "MedicationRequest",
                "DiagnosticReport",
                "AllergyIntolerance",
                "Immunization",
                "Procedure"
              ],
              "description": "Clinical resource type."
            },
            "count": {
              "description": "Max results (default 25).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "patientId",
            "resourceType"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
